// Copy this file to Secrets.xcconfig (same folder) and fill in the two values.
// Secrets.xcconfig is git-ignored. Do not commit it.
//
// Both values are on the Supabase dashboard: Project Settings > API.
//
//   Project URL        -> SUPABASE_URL
//   anon / publishable -> SUPABASE_ANON_KEY
//
// Write the URL with  https:/$()/  instead of  https://  because // starts a comment in this file format.
// Use ONLY the anon (public) or publishable key. Never put the service_role / secret key or the
// database password here: they would ship inside the app. The app refuses a service-role key.

SUPABASE_URL = https:/$()/YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY = YOUR-ANON-OR-PUBLISHABLE-KEY
