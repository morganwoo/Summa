# With no AI_API_KEY the service runs in mock mode and drafts plans deterministically,
# so the whole app journey works without paid credentials.
PORT=8787

# Any OpenAI-compatible chat completions endpoint. Keep the key here, never in the app.
# AI_BASE_URL=https://ai.gateway.lovable.dev/v1
# AI_API_KEY=
# AI_MODEL=google/gemini-2.5-flash

# Plans allowed per install per window.
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_SECONDS=600

# --- Only for `node --env-file=.env supabase/verify.mjs` (checks accounts and friend requests end to end) ---
# Supabase dashboard > Project Settings > API. Keep this file out of Git (.env is ignored).
# SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# SUPABASE_ANON_KEY=
# The service-role key is used only by that script, on your machine, to create and delete throwaway
# test users. It is never used by the app and must never be placed in ios/.
# SUPABASE_SERVICE_ROLE_KEY=

# Reflection companion (Summa Pro). The server verifies the App Store transaction the app sends.
# Xcode = local StoreKit testing only (signatures are not checked). Never deploy with Xcode.
# For TestFlight/App Store use Sandbox or Production, and point APPLE_ROOT_CERT_FILE at
# "Apple Root CA - G3" downloaded from https://www.apple.com/certificateauthority/
APPLE_ENVIRONMENT=Xcode
APPLE_BUNDLE_ID=app.summa.Summa
# APPLE_ROOT_CERT_FILE=./AppleRootCA-G3.cer
# COMPANION_DAILY_MAX=40
